# MinSU Clearance System — Apache config for Hostinger
# Place this in your `public_html` (or app root) directory.

RewriteEngine On

# 1) Route all /api/* requests to the PHP front controller
RewriteRule ^api/?$              api/index.php [L,QSA]
RewriteRule ^api/(.+)$           api/index.php?path=/$1 [L,QSA]

# 2) SPA fallback — send everything else to index.html
#    (preserves deep links / refresh support without needing HashRouter)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L,QSA]

# 3) Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# 4) Protect config from being downloaded
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|\.env|.*\.log)$">
    Require all denied
</FilesMatch>

# 5) Deny access to /api/lib directly
<IfModule mod_rewrite.c>
    RewriteRule ^api/lib/ - [F,L]
</IfModule>

# 6) Gzip compression (nice for slow connections)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# 7) Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg            "access plus 30 days"
    ExpiresByType image/png             "access plus 30 days"
</IfModule>
